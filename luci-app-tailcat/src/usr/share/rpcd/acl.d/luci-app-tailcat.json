{
	"luci-app-tailcat": {
		"description": "Grant access to tailcat service configuration and status",
		"read": {
			"ubus": {
				"service": [ "list" ],
				"file": [ "list", "read", "stat", "exec" ]
			},
			"uci": [ "tailcat" ],
			"fs": {
				"/var/log/tailcat": [ "list", "read" ],
				"/var/run/tailcat": [ "list", "read" ],
				"/etc/config/tailcat": [ "read" ],
				"/etc/init.d/tailcat": [ "read", "exec" ],
				"/usr/bin/tailcat": [ "stat", "exec" ],
				"/bin/sh": [ "exec" ],
				"/usr/lib/tailcat/tailcat-derp-info.sh": [ "exec" ],
				"/usr/lib/tailcat/tailcat-fetch-kernel.sh": [ "exec" ]
			}
		},
		"write": {
			"ubus": {
				"file": [ "write", "remove", "exec" ],
				"service": [ "list" ]
			},
			"uci": [ "tailcat" ]
		}
	}
}
